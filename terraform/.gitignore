*.tfstate.*
*.tfstate.backup

# Plan output files.
*tfplan*

# Crash logs.
crash.log
crash.*.log

# Override files (local developer customisations, not for VCS).
override.tf
override.tf.json
*_override.tf
*_override.tf.json
/workspaces/dev/terraform.tfvars
